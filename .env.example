# Apenas valores de exemplo. Nunca guardar credenciais no Git.
PORT=3000
FIREBASE_PROJECT_ID=demo-painel
USE_FIREBASE_EMULATORS=true
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_WEB_API_KEY=demo-key
FIREBASE_AUTH_DOMAIN=demo-painel.firebaseapp.com
# Produção: USE_FIREBASE_EMULATORS=false, projeto real e Application Default Credentials.
# URL pública HTTPS usada nos callbacks e webhooks.
APP_BASE_URL=http://127.0.0.1:3000
# Chave aleatória de 32 bytes, em base64, para cifrar tokens de integrações.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
META_APP_ID=
META_APP_SECRET=
# Definir uma versão Graph API ainda suportada pela aplicação Meta.
META_API_VERSION=v24.0
SYNC_INTERVAL_MS=900000
