{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "painel-shopify",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/oauth/*", "/webhooks/*", "/painel-negocio-3.html"]
  },
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "USE_FIREBASE_EMULATORS": "false",
    "FIREBASE_PROJECT_ID": "painel-cash-on-delivery",
    "FIREBASE_WEB_API_KEY": "AIzaSyC8vdVHyNgk4IDWNvwoMqzspCEvp-Mz5Mg",
    "FIREBASE_AUTH_DOMAIN": "painel-cash-on-delivery.firebaseapp.com",
    "APP_BASE_URL": "https://painel-shopify.lobojose348.workers.dev",
    "SHOPIFY_API_VERSION": "2026-07",
    "META_API_VERSION": "v24.0"
  },
  "env": {
    "local": {
      "name": "painel-shopify-local",
      "vars": {
        "USE_FIREBASE_EMULATORS": "true",
        "FIREBASE_PROJECT_ID": "demo-painel",
        "FIREBASE_WEB_API_KEY": "demo-key",
        "FIREBASE_AUTH_DOMAIN": "demo-painel.firebaseapp.com",
        "APP_BASE_URL": "http://127.0.0.1:8787",
        "SHOPIFY_API_VERSION": "2026-07",
        "META_API_VERSION": "v24.0"
      }
    }
  }
}
