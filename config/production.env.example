PORT=3000
USE_FIREBASE_EMULATORS=false
FIREBASE_PROJECT_ID=painel-cash-on-delivery
FIREBASE_AUTH_DOMAIN=painel-cash-on-delivery.firebaseapp.com
# Configuração Web pública fornecida pelo proprietário.
FIREBASE_WEB_API_KEY=AIzaSyC8vdVHyNgk4IDWNvwoMqzspCEvp-Mz5Mg
# Endereço público HTTPS comunicado pelo proprietário.
APP_BASE_URL=https://painel-shopify.lobojose348.workers.dev
# Credenciais e chave de cifragem: preencher apenas no gestor de segredos.
INTEGRATION_ENCRYPTION_KEY=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
META_APP_ID=
META_APP_SECRET=
